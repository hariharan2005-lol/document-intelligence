# Document Intelligence Pipeline Configuration

APP_NAME="Document Intelligence Pipeline"
DEBUG=false

# Database
DATABASE_URL="sqlite:///./documents.db"

# Storage
STORAGE_DIR="./storage/documents"
MAX_UPLOAD_SIZE_BYTES=15728640 # 15 MB

# LLM Provider configuration: 'openai' (default primary), 'anthropic', 'gemini', or 'mock'
LLM_PROVIDER="openai"

# OpenAI Configuration (if LLM_PROVIDER="openai")
# Can also point to local OpenAI-compatible endpoints like Ollama (e.g. http://localhost:11434/v1)
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL=""

# Anthropic Configuration (if LLM_PROVIDER="anthropic")
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Gemini Configuration (if LLM_PROVIDER="gemini")
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Fallback to heuristic extractor if live LLM API call fails or key is not set
ENABLE_HEURISTIC_FALLBACK=true

# Optional Tesseract OCR binary path on Windows (e.g. C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=""
